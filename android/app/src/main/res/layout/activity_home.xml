<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_bff_mark"
            android:contentDescription="@null"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BestFoneFinder"
            android:fontFamily="@font/nunito_black"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Fees... No Ads... No BS... Phone FOUND!"
            android:textSize="12sp"
            android:textColor="#666666" />
    </LinearLayout>

    <LinearLayout android:id="@+id/btnSettings" style="@style/MenuCard">
        <TextView style="@style/MenuIcon" android:text="⚙️" />
        <TextView style="@style/MenuText" android:text="Settings" />
        <TextView style="@style/MenuChevron" />
    </LinearLayout>

    <LinearLayout android:id="@+id/btnHistory" style="@style/MenuCard">
        <TextView style="@style/MenuIcon" android:text="🕐" />
        <TextView style="@style/MenuText" android:text="History" />
        <TextView style="@style/MenuChevron" />
    </LinearLayout>

    <LinearLayout android:id="@+id/btnShare" style="@style/MenuCard">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_share"
            android:contentDescription="@null"
            android:layout_marginEnd="16dp" />
        <TextView style="@style/MenuText" android:text="Share" />
        <TextView style="@style/MenuChevron" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnAbout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="About"
        android:textColor="#00C853"
        android:textSize="13sp"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
