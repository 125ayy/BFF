<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="24dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@drawable/ic_bff_mark"
        android:contentDescription="@null"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BFF needs 5 permissions"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="28dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="8dp"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/icon_circle_green"
                android:layout_marginEnd="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📩"
                    android:textSize="18sp" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMS"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="reads the BFF text"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/imgSmsStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_circle_empty" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/icon_circle_green"
                android:layout_marginEnd="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="👥"
                    android:textSize="18sp" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contacts"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="knows who is texting"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/imgContactsStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_circle_empty" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/icon_circle_green"
                android:layout_marginEnd="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔔"
                    android:textSize="18sp" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notifications"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="shows the alarm"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/imgNotifStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_circle_empty" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/icon_circle_green"
                android:layout_marginEnd="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔊"
                    android:textSize="18sp" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sound"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="rings on silent"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/imgAudioStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_circle_empty" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A" />
        <LinearLayout android:id="@+id/rowGps" android:clickable="true" android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/icon_circle_green"
                android:layout_marginEnd="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📍"
                    android:textSize="18sp" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvGpsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sends location via SMS"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/imgGpsStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_circle_empty" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPermissionError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:textColor="#FF5252"
        android:textSize="13sp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <Button
        android:id="@+id/btnContinue"
        style="@style/PrimaryButton"
        android:text="ALLOW" />

</LinearLayout>
